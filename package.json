{
  "name": "vue-web3-nav",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "update:funds": "node scripts/update-us-funds.mjs",
    "update:a-share": "node scripts/update-a-share-sectors.mjs",
    "update:kols": "node scripts/update-kols.mjs",
    "update:news": "node scripts/update-market-news.mjs",
    "update:cross-asset": "node scripts/update-cross-asset.mjs",
    "update:technical-events": "node scripts/update-technical-events.mjs",
    "update:fund-transmission": "node scripts/update-fund-transmission.mjs",
    "update:hot-stocks": "node scripts/update-hot-stocks.mjs",
    "update:us-megacaps": "node scripts/update-us-megacaps.mjs",
    "update:us-stock-technicals": "node scripts/update-us-stock-technicals.mjs",
    "update:option-market": "node scripts/update-option-market.mjs",
    "cloudflare:types": "wrangler types worker/env.d.ts",
    "cloudflare:check": "npm run cloudflare:types && tsc -p tsconfig.worker.json --noEmit && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cloudflare:dev": "wrangler dev --local --test-scheduled",
    "cloudflare:db:local": "wrangler d1 migrations apply DB --local",
    "cloudflare:db:remote": "wrangler d1 migrations apply DB --remote",
    "cloudflare:deploy": "npm run cloudflare:db:remote && wrangler deploy",
    "deploy": "npm run build-only && gh-pages -d dist -m \"Deploy to GitHub Pages\""
  },
  "homepage": "https://github.com/aTong9/web3",
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "echarts": "^6.1.0",
    "html2canvas": "^1.4.1",
    "js-yaml": "^4.3.1",
    "pinia": "^3.0.4",
    "posthog-js": "^1.410.6",
    "rss-parser": "^3.13.0",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "~10.6.2",
    "gh-pages": "^6.3.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.25",
    "prettier": "3.7.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.2.2",
    "wrangler": "^4.118.0"
  }
}
