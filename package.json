{
  "name": "vue-web3-nav",
  "productName": "FIRE Finance Workbench",
  "version": "0.2.0",
  "description": "聚合市场数据、量化信号、金融资讯与常用资源的个人金融研究工作台",
  "desktopName": "fire-finance-workbench.desktop",
  "author": {
    "name": "aTong9",
    "email": "aTong9@users.noreply.github.com",
    "url": "https://github.com/aTong9"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently --kill-others-on-fail \"cross-env VITE_APP_TARGET=electron vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:2333 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:2333 electron .\"",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:electron": "cross-env VITE_APP_TARGET=electron vite build",
    "electron:dist": "npm run type-check && npm run build:electron && electron-builder --publish never",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "npm run test:trading",
    "test:trading": "node --test tests/*.test.mjs",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "update:funds": "node scripts/update-us-funds.mjs",
    "update:a-share": "node scripts/update-a-share-sectors.mjs",
    "update:kols": "node scripts/update-kols.mjs",
    "update:news": "node scripts/update-market-news.mjs",
    "update:cross-asset": "node scripts/update-cross-asset.mjs",
    "update:technical-events": "node scripts/update-technical-events.mjs",
    "update:technical-funds": "node scripts/update-technical-funds.mjs",
    "update:fund-transmission": "node scripts/update-fund-transmission.mjs",
    "update:hot-stocks": "node scripts/update-hot-stocks.mjs",
    "update:us-megacaps": "node scripts/update-us-megacaps.mjs",
    "update:us-stock-technicals": "node scripts/update-us-stock-technicals.mjs",
    "update:option-market": "node scripts/update-option-market.mjs",
    "auth:recovery-code": "node scripts/create-admin-recovery-code.mjs",
    "cloudflare:types": "wrangler types worker/env.d.ts --env-file .dev.vars.example --strict-vars false",
    "cloudflare:check": "npm run test:trading && npm run cloudflare:types && tsc -p tsconfig.worker.json --noEmit && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cloudflare:dev": "wrangler dev --local --test-scheduled",
    "cloudflare:db:local": "wrangler d1 migrations apply DB --local",
    "cloudflare:db:remote": "wrangler d1 migrations apply DB --remote",
    "cloudflare:deploy": "npm run test:trading && npm run cloudflare:db:remote && wrangler deploy",
    "deploy": "npm run build-only && gh-pages -d dist -m \"Deploy to GitHub Pages\""
  },
  "homepage": "https://github.com/aTong9/web3",
  "build": {
    "appId": "com.atong9.fire-workbench",
    "productName": "FIRE Finance Workbench",
    "directories": {
      "output": "release"
    },
    "icon": "pwa/icons/icon-512.png",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/debug/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/argparse/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/ms/**/*",
      "node_modules/sax/**/*",
      "node_modules/semver/**/*",
      "node_modules/universalify/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "aTong9",
      "repo": "web3"
    },
    "asar": true,
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "category": "Office",
      "maintainer": "aTong9 <aTong9@users.noreply.github.com>",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "FIRE-Finance-Workbench-${version}-${os}-${arch}.${ext}"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "echarts": "^6.1.0",
    "electron-updater": "^6.8.9",
    "fs-extra": "^10.1.0",
    "html2canvas": "^1.4.1",
    "js-yaml": "^4.3.1",
    "pinia": "^3.0.4",
    "posthog-js": "^1.410.6",
    "rss-parser": "^3.13.0",
    "semver": "^7.7.4",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "~10.6.2",
    "gh-pages": "^6.3.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.25",
    "prettier": "3.7.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.2.2",
    "wait-on": "^9.1.0",
    "wrangler": "^4.118.0"
  }
}
